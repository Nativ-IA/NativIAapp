{
  "name": "@nativia/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "//": "Un solo .env en la raíz del monorepo. dotenv-cli lo inyecta aquí porque Prisma lo busca relativo al cwd, no a la raíz del workspace.",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate --schema=./schema.prisma",
    "push": "dotenv -e ../../.env -- prisma db push --schema=./schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=./schema.prisma",
    "studio": "dotenv -e ../../.env -- prisma studio --schema=./schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force --schema=./schema.prisma"
  },
  "dependencies": {
    "@nativia/content": "workspace:*",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
