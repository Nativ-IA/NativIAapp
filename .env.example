# Copia este archivo como .env, en la raíz del monorepo:
#   Copy-Item .env.example .env

# Rama de Neon para trabajar en local (dev). Se sacan con el botón Connect:
#   con "Connection pooling" activado   → DATABASE_URL (la usa la app)
#   con "Connection pooling" desactivado → DATABASE_URL_UNPOOLED (las migraciones)
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cualquier texto de 16 caracteres o más. En la nube va uno aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# true: el tutor responde desde los árboles pregrabados (sin API key ni costo).
MOCK_LLM=true

# Para el tutor real: MOCK_LLM=false y una clave de Anthropic.
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5-5
# CLASSIFIER_MODEL=claude-haiku-5-5

# Aparte, en .env.neon-production (no se sube a git): las mismas dos variables
# de la rama production, para pnpm db:deploy:production y demo:reset:production.
