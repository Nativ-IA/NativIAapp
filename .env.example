# Copia este archivo como .env, en la raíz del monorepo:
#   Copy-Item .env.example .env

# Ruta relativa a packages/db/schema.prisma.
DATABASE_URL="file:./nativia.db"

# Cualquier texto de 16 caracteres o más. En la nube va uno aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# true: el tutor responde desde los árboles pregrabados (sin API key ni costo).
MOCK_LLM=true

# Para el tutor real: MOCK_LLM=false y una clave de Anthropic.
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5-5
# CLASSIFIER_MODEL=claude-haiku-5-5
