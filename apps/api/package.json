{
  "name": "@nativia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "start corre con tsx porque @nativia/db y @nativia/content se publican como TypeScript sin compilar.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:modules": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/request-context": "^6.2.1",
    "@fastify/static": "^8.3.0",
    "@nativia/content": "workspace:*",
    "@nativia/db": "workspace:*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "dependency-cruiser": "^18.7.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
